rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and user-scoped data isolation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Explicitly restrict access to user-scoped boundaries
    match /users/{userId} {
      // User document & account meta
      allow read, write: if isOwner(userId);

      // Metadata subcollection (e.g. syncInfo)
      match /meta/{metaId} {
        allow read, write: if isOwner(userId);
      }

      // Knowledge Objects subcollection
      match /items/{itemId} {
        allow read, write: if isOwner(userId);
      }

      // Connection Patterns subcollection
      match /patterns/{patternId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
